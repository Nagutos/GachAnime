{
  "name": "gachanime",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@gachanime/e2e",
    "test:e2e": "pnpm --filter @gachanime/e2e test",
    "i18n:check": "pnpm --filter @gachanime/web i18n:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @gachanime/db generate",
    "db:migrate": "pnpm --filter @gachanime/db migrate",
    "db:seed": "pnpm --filter @gachanime/db seed",
    "admin:promote": "pnpm --filter @gachanime/core admin:promote",
    "admin:grant-gems": "pnpm --filter @gachanime/core admin:grant-gems",
    "economy:simulate": "pnpm --filter @gachanime/core economy:simulate",
    "import:anilist": "pnpm --filter @gachanime/importer import:anilist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsonc-eslint-parser": "^3.0.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vue-eslint-parser": "^10.3.0"
  }
}
