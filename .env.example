# ─── GachAnime configuration ─────────────────────────────────────────────────
# Copy to `.env` and fill the values. The same file is used by `docker compose`
# (self-hosting) and by `pnpm dev` (development).

# Public URL of your instance, as players type it in their browser (no trailing slash).
# Development: http://localhost:5173 · Docker default: http://localhost:8080
PUBLIC_URL=http://localhost:8080

# Random secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Discord application (https://discord.com/developers/applications → OAuth2).
# Add the redirect URL: <PUBLIC_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord user ids (comma separated) promoted to admin when they sign in.
# Discord → Settings → Advanced → Developer mode, then right click your name → Copy User ID.
# Alternative, after the user signed in once:
#   docker compose run --rm -w /app/packages/core migrate \
#     node --import tsx src/cli/admin-promote.ts --discord-id <id>
#   (development: pnpm admin:promote -- --discord-id <id>)
ADMIN_DISCORD_IDS=

# Optional: video game characters from IGDB (free for non-commercial use). Create an application
# at https://dev.twitch.tv/console/apps (OAuth redirect URL: http://localhost, category: Website
# Integration, client type: Confidential), then copy its Client ID and a new client secret.
# Leave both empty to disable video game imports.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── Docker compose only ─────────────────────────────────────────────────────
# docker-compose.prod.yml (published images): `latest` = last release, `1.2` = last 1.2.x,
# `1.2.3` = that release, `edge` = current main. Ignored by docker-compose.yml (builds from source).
GACHANIME_VERSION=latest
POSTGRES_USER=gachanime
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gachanime
# ":80" serves plain HTTP (put your own reverse proxy in front), or set a domain name
# (e.g. gachanime.example.com) to let Caddy get a TLS certificate automatically
# (then expose ports 80/443 with HTTP_PORT=80 and HTTPS_PORT=443).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Behind Traefik (docker-compose.traefik.yml, see docs/SELF_HOSTING.md#https): no port is
# published, Traefik routes TRAEFIK_HOST to the stack.
TRAEFIK_HOST=
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# ─── Development only (`pnpm dev`, see docker-compose.dev.yml) ───────────────
DATABASE_URL=postgres://gachanime:gachanime@localhost:5433/gachanime
TEST_DATABASE_URL=postgres://gachanime:gachanime@localhost:5433/gachanime_test
REDIS_URL=redis://localhost:6380
