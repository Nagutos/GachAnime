# SITE_ADDRESS: ":80" (plain HTTP, behind your own proxy) or a domain such as
# "gachanime.example.com" (Caddy then obtains a TLS certificate automatically).

{
	servers {
		# Behind another proxy (Traefik, nginx…) on a private network, keep the client IP and
		# scheme it forwards (X-Forwarded-For / -Proto). Clients from the Internet never have a
		# private address, so they cannot forge these headers. TRUSTED_PROXIES overrides the list.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Same values as apps/web/security-headers.ts (a unit test keeps them in sync).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.anilist.co https://images.igdb.com https://cdn.discordapp.com; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Ignored by browsers over plain HTTP; enforced once the instance is served over HTTPS.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Built assets have content-hashed names: cache them forever. index.html is always revalidated.
	@hashedAssets path /assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
	@spaShell not path /api/* /media/* /assets/*
	header @spaShell Cache-Control "no-cache"

	request_body {
		max_size 10MB
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle_path /media/* {
		# Uploaded and cached images get a new random file name whenever they change.
		header Cache-Control "public, max-age=31536000, immutable"
		root * /data/uploads
		file_server
	}

	# Missing hashed assets (an old chunk after an upgrade) must 404, never fall back to the
	# SPA shell: the shell would be cached forever under the asset URL.
	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
